<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lumen.fakedc"
    android:versionCode="276"
    android:versionName="1.0.2">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <!-- v235: 配置兜底通道之一 —— 写 Settings.System。
         需要在「应用信息 → 特殊权限 → 修改系统设置」里手动授予；
         没授予时 UI 会自动回落到文件通道，不影响使用。 -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />


    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- v225: libxposed 官方服务通道的 provider —— 必须声明，
             否则框架无法把 XposedService 交付给本 app（UI 就写不进配置）。
             authority 固定为 <applicationId>.XposedService（官方 AAR 约定）。 -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.lumen.fakedc.XposedService"
            android:exported="true" />

        <!-- v266: **真正的配置通道** —— 模块通过它读用户配置。
             UI 写自己的 SharedPreferences（100% 可写），本 provider 只读暴露。
             exported=true 是必须的：查询方是 system_server（模块所在进程）。
             暴露的内容仅「总开关 + DC 下限」两个数值，无任何隐私数据。 -->
        <provider
            android:name=".CfgProvider"
            android:authorities="com.lumen.fakedc.cfg"
            android:exported="true" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
